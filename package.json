{
  "name": "mikodb",
  "version": "1.0.0",
  "description": "MikoDB — curated anime extension repo + canonical anime identity mapping database for Miko",
  "private": true,
  "scripts": {
    "build:index": "node scripts/build-index.js",
    "build:db": "node scripts/build-db.js",
    "build": "node scripts/build-index.js && node scripts/build-db.js",
    "check:episodes": "node scripts/check-episodes.mjs dist/miko-anime-map.db"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.2.0"
  }
}
